# Firebase web app configuration (not a private model API key).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
# Production App Check reCAPTCHA Enterprise site key.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Local development only: generate a token in Chrome and register it in Firebase.
VITE_APPCHECK_DEBUG=false
# Optional supported Firebase cloud model override. Empty uses the SDK default.
VITE_FIREBASE_MODEL=
# Never put private third-party API keys in VITE_ variables: these ship to browsers.
